[gd_scene format=3]

[ext_resource type="Script" path="res://ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Theme" path="res://ui/menu_theme.tres" id="2_theme"]
[ext_resource type="FontFile" path="res://assets/fonts/Jacquard12-Regular.ttf" id="3_title"]
[ext_resource type="Script" path="res://ui/menu_button_fx.gd" id="4_fx"]
[ext_resource type="PackedScene" path="res://ui/save_load_panel.tscn" id="5_panel"]

[node name="PauseMenu" type="CanvasLayer"]
layer = 20
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0.05, 0.09, 0.72)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Root/Center/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.86, 0.9, 0.97, 1)
theme_override_fonts/font = ExtResource("3_title")
theme_override_font_sizes/font_size = 80
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Root/Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Resume"
script = ExtResource("4_fx")

[node name="SaveButton" type="Button" parent="Root/Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Save Game"
script = ExtResource("4_fx")

[node name="LoadButton" type="Button" parent="Root/Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Load Game"
script = ExtResource("4_fx")

[node name="MenuButton" type="Button" parent="Root/Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Main Menu"
script = ExtResource("4_fx")

[node name="SaveLoadPanel" parent="Root" instance=ExtResource("5_panel")]
layout_mode = 1
